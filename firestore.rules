rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.admin == true ||
        request.auth.token.email == 'hamidelhajaouya1@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'));
    }

    // Default deny for all unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Explicitly lock credentials collection - Server-only access
    match /_auth_credentials/{docId} {
      allow read, write: if false;
    }

    // Connection health check & diagnostics probe
    match /test/{docId} {
      allow read, write: if true;
    }

    // 1. Users collection: Document ID must be Firebase Auth UID or test UID
    match /users/{userId} {
      // User can read their own profile; Admin can read and list
      allow get: if isOwner(userId) || isAdmin() || userId.matches('^usr_.*');
      allow list: if true;

      // Create new user profile:
      allow create: if ((isOwner(userId) || userId.matches('^usr_.*')) &&
        request.resource.data.uid == userId &&
        (request.resource.data.role == 'customer' || request.resource.data.role == 'provider') &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)) || isAdmin();

      // Update user profile:
      allow update: if ((isOwner(userId) || userId.matches('^usr_.*')) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.role == resource.data.role &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin)) || isAdmin();

      // Deletion: restricted to Admin or test users
      allow delete: if isAdmin() || userId.matches('^usr_.*');
    }

    // 2. Providers collection: Public read for active profiles; write restricted to provider owner or Admin, or rating update
    match /providers/{providerId} {
      // Anyone can read active provider profiles; Admin can read all
      allow read: if resource == null || resource.data.isActive == true || isAdmin();

      // Provider creation: authenticated provider owner or Admin or demo provider
      allow create: if (isSignedIn() &&
        (request.resource.data.id == request.auth.uid || request.resource.data.userId == request.auth.uid)) || 
        isAdmin() || 
        providerId.matches('^usr_.*') ||
        providerId.matches('^pro_.*');

      // Provider update: provider themselves, Admin, demo provider, or rating recalculation
      allow update: if (isSignedIn() &&
        (resource.data.id == request.auth.uid || resource.data.userId == request.auth.uid) &&
        request.resource.data.createdAt == resource.data.createdAt) || 
        isAdmin() || 
        providerId.matches('^usr_.*') ||
        providerId.matches('^pro_.*') ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewsCount', 'updatedAt']);

      allow delete: if isAdmin() || providerId.matches('^usr_.*') || providerId.matches('^pro_.*');
    }

    // Tombstones & Deleted Accounts collections: read/write by Admin only or demo tombstones
    match /tombstones/{tombstoneId} {
      allow read, write: if isAdmin() || tombstoneId.matches('^usr_.*');
    }

    match /deleted_accounts/{accountId} {
      allow read, write: if isAdmin() || accountId.matches('^usr_.*');
    }

    // 3. Customers collection
    match /customers/{customerId} {
      allow read, write: if isAdmin() || isOwner(customerId) || customerId.matches('^usr_.*');
    }

    // 4. Cities and Professions (Read-only master lookup data)
    match /cities/{cityId} {
      allow read: if true;
      allow write: if false;
    }

    match /professions/{professionId} {
      allow read: if true;
      allow write: if false;
    }

    // 5. Favorites: User can read/manage their own favorites; Admin has full management
    match /favorites/{favoriteId} {
      allow read, write: if isAdmin() || (isSignedIn() &&
        (resource == null || resource.data.customerId == request.auth.uid) &&
        (request.resource == null || request.resource.data.customerId == request.auth.uid)) ||
        (resource != null && (resource.data.customerId.matches('^usr_demo_.*') || resource.data.providerId.matches('^usr_demo_.*'))) ||
        (request.resource != null && (request.resource.data.customerId.matches('^usr_demo_.*') || request.resource.data.providerId.matches('^usr_demo_.*')));
    }

    // 6. Reviews: Anyone can read reviews; authenticated or demo customer/admin can create/update/delete
    match /reviews/{reviewId} {
      allow read: if true;

      // Creation: customer can create with valid rating 1-5 and non-empty comment
      allow create: if ((isSignedIn() && request.resource.data.customerUid == request.auth.uid) ||
        (request.resource.data.customerUid.matches('^usr_demo_.*'))) &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() > 0;

      // Update: customer can update their review but cannot change customerUid or providerId
      allow update: if ((isSignedIn() && resource.data.customerUid == request.auth.uid) ||
        isAdmin() ||
        (resource.data.customerUid.matches('^usr_demo_.*'))) &&
        request.resource.data.customerUid == resource.data.customerUid &&
        request.resource.data.providerId == resource.data.providerId &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        request.resource.data.comment is string &&
        request.resource.data.comment.size() > 0;

      // Deletion: customer can delete their own review or admin
      allow delete: if (isSignedIn() && resource.data.customerUid == request.auth.uid) ||
        isAdmin() ||
        (resource.data.customerUid.matches('^usr_demo_.*')) ||
        (resource.data.providerId.matches('^usr_demo_.*'));
    }

    // 7. Notifications: User can read and update their own notifications; users can create notifications for others
    match /notifications/{notificationId} {
      allow read, update, delete: if (isSignedIn() &&
        (resource.data.recipientUid == request.auth.uid || isAdmin())) ||
        (resource.data.recipientUid.matches('^usr_demo_.*')) ||
        (resource.data.actorUid.matches('^usr_demo_.*'));

      allow create: if ((isSignedIn() && request.resource.data.actorUid == request.auth.uid) ||
        (request.resource.data.actorUid.matches('^usr_demo_.*')));
    }

    // 8. Likes collection: Authenticated user can create and remove their own like
    match /likes/{likeId} {
      allow read: if true;
      allow create: if (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
        (request.resource.data.userId.matches('^usr_demo_.*'));
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) ||
        (resource.data.userId.matches('^usr_demo_.*'));
    }
  }
}
